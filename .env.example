# Environment variables are read from the process. Keep real values out of source control.
# For a local .env file, start with: node --env-file=.env server/index.mjs
# APP_PASSCODE=replace-with-your-private-passcode
# APP_ORIGIN=https://your-becoming-service.onrender.com
# DATA_DIR=/var/data/becoming
# PORT=4173
# HOST=127.0.0.1
# Optional OpenAI project API connection. Never use VITE_ for secrets.
# OPENAI_API_KEY=your-project-api-key
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# OPENAI_REVIEW_MODEL=gpt-6-luna
# Optional host-only encrypted credential directory, outside dist:
# OPENAI_CONFIG_DIR=/var/data/hpy-openai
